<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Ô nhập tên khoản chi -->
    <EditText
        android:id="@+id/edtTenKhoanChi_117"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khoản chi"
        android:inputType="text" />

    <!-- Ô nhập số tiền -->
    <EditText
        android:id="@+id/edtSoTien_117"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền"
        android:inputType="numberDecimal" />

    <!-- Ô nhập ghi chú -->
    <EditText
        android:id="@+id/edtGhiChu_117"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập ghi chú (nếu có)"
        android:inputType="text" />

    <!-- Nút Thêm khoản chi -->
    <Button
        android:id="@+id/btnThem_117"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Thêm khoản chi" />

    <!-- Nút Xem chi tiết khoản chi -->
    <Button
        android:id="@+id/btnXemChiTiet_117"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Xem chi tiết khoản chi" />

</LinearLayout>